# LLM provider connections (OpenAI-compatible APIs).
# PRIMARY_PROVIDER picks the provider for every role without a ROLE_<ROLE>_PROVIDER override, the
# judge included, and config.Settings._require_bench_validated_judge refuses a judge whose
# (provider, model, base_url) is not in config.BENCH_VALIDATED_JUDGES. A PRIMARY_PROVIDER outside
# that set therefore also needs ROLE_JUDGE_PROVIDER / ROLE_JUDGE_MODEL on a validated triple.
# The router's fallback is ONE provider, fixed by order (config.Settings.fallback_provider: groq,
# else openai; never zenmux) and used only when it is configured (llm.LLMRouter._usable_fallback).
# The judge never fails over (ADR 0009a).
# Copy this file to .env and fill in the values. .env is gitignored.
# Only config.Settings reads .env. LLM_DAILY_TOKEN_BUDGET, LLM_SESSION_TOKEN_BUDGET,
# COACH_DAILY_QUESTION_CAP, COACH_USAGE_LEDGER, COACH_LOG_FILE and WEB_CONCURRENCY are read from the
# process environment only: compose delivers them through `env_file`, but under `uv run` a value set
# only in .env is ignored, so export it in the shell instead.

# OpenAI is the primary provider (issue 0031 — gpt-5.4-mini free daily tier).
# One key here is the ONLY secret a fresh clone needs for a live session.
PRIMARY_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

# --- Groq (optional fallback) ---
# NOTE: llama-3.3-70b does NOT pass the judge calibration bench (VN over-scoring Δ=2.00,
# docs/audits/calibration-bench-2026-07-11-gpt-5.4-mini.md) — fallback is for availability,
# not judge quality.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=<your-groq-model-id>

# --- ZenMux (optional — AVAILABILITY ONLY; never the router's fallback, never the judge) ---
# An OpenAI-compatible aggregator, disqualified from scoring. config.Settings.fallback_provider
# never selects it, so it serves only as PRIMARY_PROVIDER=zenmux (with ROLE_JUDGE_PROVIDER /
# ROLE_JUDGE_MODEL on a validated triple) or as ROLE_<ROLE>_PROVIDER=zenmux for a non-judge role.
# It routes each request across upstream providers, and across models too when
# ZENMUX_MODEL=zenmux/auto, so "the judge" would not be a fixed model at a fixed endpoint, and
# ADR 0009 pins the judge to a named (provider, model, base_url) with a green `coach bench` artifact
# (config.BENCH_VALIDATED_JUDGES). Unless COACH_ALLOW_UNVALIDATED_JUDGE is set (below),
# ROLE_JUDGE_PROVIDER=zenmux is refused wherever the judge client is built (llm.build_role_clients):
# at startup for CLI commands, and at the start of every live Session under `coach api` (the
# server itself starts and answers /api/health).
# ZENMUX_API_KEY=
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# ZENMUX_MODEL=<provider/model-id>
# Function-calling and strict json_schema grammars are opted out until measured on a pinned model:
# ZENMUX_SUPPORTS_JSON_SCHEMA=true

# Run the judge on a provider with NO bench artifact. Off by default and deliberately awkward:
# scores produced this way are not comparable to bench-validated ones (ADR 0009).
# It logs a WARNING each time the judge client is built (at CLI startup; at the start of each live
# Session under `coach api`) and stamps "unvalidated judge" into every TurnTrace and export.
# COACH_ALLOW_UNVALIDATED_JUDGE=1

# --- Optional ---
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# --- Web gate (R-07) ---
# UNSET = OPEN, which is the right default for localhost and the wrong one anywhere reachable.
# Set both before exposing `coach api` on a network. The token must be ASCII (HTTP headers are
# latin-1 on the wire, so a non-ASCII passphrase cannot round-trip and the server refuses to start).
# Generate one with: openssl rand -hex 32
# The browser UI asks for this token at runtime — never build it into the bundle, where anyone who
# can fetch the app can read it back out.
# COACH_AUTH_TOKEN=
# Comma-separated browser origins allowed to open a Session socket. Required alongside the token:
# unset, the WebSocket falls back to the Vite dev origins and will reject your deployed UI.
# COACH_ALLOWED_ORIGINS=https://coach.example.com

# --- Per-role routing (ADR 0010) ---
# Each agent role can override its provider, model, and temperature; unset roles inherit
# PRIMARY_PROVIDER + that provider's model + LLM_TEMPERATURE (the pre-0010 behavior).
# Roles: JUDGE, INTERVIEWER, SUPERVISOR, DIAGNOSTIC, PLANNER.
# The judge role is PINNED (ADR 0009a): it never fails over to another model, and changing
# ROLE_JUDGE_* is a judge change — `coach bench` must pass before it merges (ADR 0009).
# ROLE_JUDGE_PROVIDER=openai
# ROLE_JUDGE_MODEL=gpt-5.4-mini
# ROLE_JUDGE_TEMPERATURE=0.2
# ROLE_INTERVIEWER_PROVIDER=groq
# ROLE_INTERVIEWER_MODEL=openai/gpt-oss-120b
# ROLE_INTERVIEWER_TEMPERATURE=0.7
# ROLE_SUPERVISOR_TEMPERATURE=0.1
# ROLE_PLANNER_TEMPERATURE=0.4

# Per-model capability override: whether the provider's configured model accepts strict
# `response_format: json_schema` grammars. Unset defers to the client class default (True only for
# llm.OpenAIClient; Groq and ZenMux inherit False from llm._OpenAICompatibleClient). Flip it when
# pointing a provider entry at a schema-capable compatible endpoint.
# OPENAI_SUPPORTS_JSON_SCHEMA=true
# GROQ_SUPPORTS_JSON_SCHEMA=false

# Free-tier budget rail: the daily allowance is NOT exposed by the API (headers only carry the
# per-minute window), so every call is counted client-side into COACH_USAGE_LEDGER and
# `coach usage` / the bench report show the day's spend against LLM_DAILY_TOKEN_BUDGET (both read
# from the process environment only; see the top of this file).
# A host path for a local checkout; under compose it is overridden to /app/state/usage-ledger.jsonl,
# because this file is the budget balance and has to survive container replacement, and because
# /app is root-owned in the image, so a relative path is unwritable to uid 10001 (M0a / F1). An
# unwritable ledger does not degrade quietly: metered calls are REFUSED, `coach usage` prints the
# reason, and a write that fails after a call was billed parks the row in COACH_USAGE_LEDGER +
# '.unreconciled' until `coach usage --reconcile` replays it. Demo mode spends nothing and is
# unaffected.
# LLM_DAILY_TOKEN_BUDGET=2500000
# COACH_USAGE_LEDGER=logs/usage-ledger.jsonl

# --- Server logging (R-12) ---
# The server logs session lifecycle + the per-call `llm-call` trace at INFO to stderr, which Docker
# keeps only until the container is recreated (e.g. a redeploy with a new image). Point this at a
# file to keep them (rotates at 10 MB, keeps 5 rotated files). Read from the process environment
# only (see the top of this file); under `uv run`, `coach api --log-file` sets it.
# A host path, like COACH_USAGE_LEDGER above: this file is written for a local checkout. Under
# compose the value below is overridden to /app/state/logs/ — the container runs as uid 10001 and
# /app is root-owned, so a relative `logs/` here would degrade to stderr-only with one
# `is not writable` warning (web_ops.configure_session_logging), which is the exact failure this
# setting exists to prevent.
# COACH_LOG_FILE=logs/coach-api.log

# NOT SUPPORTED, and the server refuses to start rather than pretend: WEB_CONCURRENCY / --workers
# above 1. Session state lives in per-process dicts over one SQLite checkpoint file — see
# docs/deploy.md §6. Compose passes this file through wholesale, so a stray value here would
# otherwise fork workers with nothing said about it. Read from the process environment only (see
# the top of this file).
# WEB_CONCURRENCY=1
#
# R-25 adds two rails on top of the day counter. Both are inert in demo mode (nothing without a
# provider spends a provider's allowance), and both are read from the process environment only (see
# the top of this file).
#
# Per-RUN runaway rail. Unset by default and DERIVED per Session from the rails that Session
# declared (usage.session_token_budget): usage.session_ceiling_multiple(max_turns) x
# usage.estimated_session_tokens(max_questions), capped at usage.worst_case_session_tokens (the full
# retry storm: usage.worst_case_session_calls x usage.WORST_CASE_TOKENS_PER_CALL). `coach usage`
# prints the derived value for a default Session. Deriving beats a flat number in both directions —
# a flat number would fire on a legitimately long interview and leave a short one several times
# more rope than it can use.
# Crossing it SUSPENDS the Session (ADR 0005): resolved questions are kept, nothing is recorded as
# `failed`, and a resume grants one more per-run budget (recorded in the ledger). Setting this makes
# the ceiling flat for every Session, which is a hard operator cap, not a runaway detector.
# LLM_SESSION_TOKEN_BUDGET=<tokens>
#
# Product cap: questions per UTC day per token identity. The identity is derived from
# COACH_AUTH_TOKEN, so with one shared secret the bucket is the whole deployment — which is why the
# default is the daily allowance restated in product units (2,500,000 / 5,200) rather than a small
# per-user number. Lower it to ration a shared deployment.
# COACH_DAILY_QUESTION_CAP=480
